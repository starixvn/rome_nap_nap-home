@using Fanex.NAP.Home.Sites.Resources
@using Fanex.NAP.Home.Sites.ViewModels.UserSites
@model SiteItem
@{
    ViewBag.Title = @ViewLang.Sites;
    Layout = null;

    var site = Model;

    var numberOfSites = (int)ViewData["numberOfSites"];
    var thumbnailContentClass = ViewData["thumbnailContentClass"].ToString();
    var numberOfSitesPerRow = (int)ViewData["numberOfSitesPerRow"];

    string thumbnailLink = "~/Images/UserSites/Thumbnails/{0}";
    string functionGroupFormat = "--- {0} ---";
    string defaultLinkParameters = string.Format("{{ \"SiteId\": {0}, \"SiteLink\": \"{1}\" }}", site.SiteId, site.DefaultLink);
    bool hasDomains = site.OtherLinkList != null && site.OtherLinkList.Count > 0;
    int functionCounter;

    string thumbnailClass = numberOfSites <= numberOfSitesPerRow ? "one-row-thumbnail" : string.Empty;

}

<div class="col-xs-2 custom-col-xs-2 thumbnail-wrapper @thumbnailClass">
    <div class="title-bar img-responsive" data-truncate-parent="true">
        <a class="title-name" title="@site.SiteName" data-strict-link="@defaultLinkParameters" data-truncate-offset="50">@site.SiteName</a>
        <span class="icon-down pull-right @(!hasDomains ? "disabled" : string.Empty)"></span>
        @if (hasDomains)
        {
            <ul class="site-domain list-unstyled" data-truncate-parent="true">
                @foreach (string link in site.OtherLinkList)
                {
                    string linkParameters = string.Format("{{ \"SiteId\": {0}, \"SiteLink\": \"{1}\" }}", site.SiteId, link);
                    <li><a href="javascript:void(0);" title="@link" data-strict-link="@linkParameters" data-truncate-offset="10">@link</a></li>
                }
            </ul>
        }
    </div>
    <img src="@Url.Content(string.Format(thumbnailLink, site.Thumbnail))" alt="@site.SiteName" class="img-responsive image" />
    <div class="thumbnail-content @thumbnailContentClass @(numberOfSites <= numberOfSitesPerRow ? "one-row-thumbnail-content" : string.Empty)">
        <div class="feature-list">
            @foreach (FunctionGroup functionGroup in site.FunctionGroupList)
            {
                functionCounter = 0;

                <div class="feature">
                    @if (functionGroup.FunctionList.Any())
                    {
                        <h6>@string.Format(functionGroupFormat, functionGroup.FunctionName)</h6>
                        <ul class="function list-unstyled">
                            @foreach (FunctionItem function in functionGroup.FunctionList)
                            {
                                string linkParameters = string.Format(
                                                            "{{ \"SiteId\": {0}, \"SiteLink\": \"{1}\", \"FunctionId\": {2}, \"FunctionLink\": \"{3}\" }}",
                                                            site.SiteId,
                                                            site.DefaultLink,
                                                            function.FunctionId,
                                                            function.FunctionLink);
                                string functionClass;

                                functionCounter++;
                                functionClass = functionCounter == functionGroup.FunctionList.Count ? "last-function" : string.Empty;

                                <li class="@functionClass"><a href="javascript:void(0);" data-strict-link="@linkParameters">@function.FunctionName</a></li>
                            }
                        </ul>
                    }
                    else
                    {
                        string linkParameters = string.Format(
                                                   "{{ \"SiteId\": {0}, \"SiteLink\": \"{1}\", \"FunctionId\": {2}, \"FunctionLink\": \"{3}\" }}",
                                                   site.SiteId,
                                                   site.DefaultLink,
                                                   functionGroup.FunctionId,
                                                   functionGroup.FunctionLink);
                        <a class="single-function" href="javascript:void(0);" data-strict-link="@linkParameters">@functionGroup.FunctionName</a>
                    }
                </div>
            }
        </div>
    </div>
</div>