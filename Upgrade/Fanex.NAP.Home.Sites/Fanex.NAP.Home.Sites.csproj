<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fanex.NAP.Home.Sites</RootNamespace>
    <UserSecretsId>f8486ce7-66af-4ef6-951b-f4a54515339e</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="codeessentials.WebOptimizer.Dotless" Version="3.1.0" />
    <PackageReference Include="Fanex.Data.ProxyClient" Version="1.0.1" />
    <PackageReference Include="Fanex.Logging" Version="2.0.1.1" />
    <PackageReference Include="Fanex.Logging.Extensions" Version="1.1.0" />
    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="1.1.0" />
    <PackageReference Include="Fanex.NAP.Signin" Version="2.0.3.1" />
    <PackageReference Include="LigerShark.WebOptimizer.Core" Version="3.0.405" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="9.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.4" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.2" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.20.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\SpName.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content> 

    <Content Update="Areas\Sites\Resources\**\*;">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </Content>
  </ItemGroup>
  

  <ItemGroup>
    <None Update="Areas\Sites\Configurations\SiteThumbnails.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>



  <ItemGroup>
    <Compile Update="Resources\ViewLang.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ViewLang.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Resources\ViewLang.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ViewLang.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>
</Project>
