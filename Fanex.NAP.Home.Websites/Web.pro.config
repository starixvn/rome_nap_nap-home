    <add key="Fanex.Logging:RabbitMQConnectionStrings" value="host=10.40.40.47;virtualHost=/fanex_logging;username=fanexlogging;password=VKREKUBBd2T3DAtosbDPojl4YQFDnDp7Yilb8JGcLQ8=" />
