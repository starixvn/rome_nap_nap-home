    <add key="Fanex.Logging:SentryBackendUrl" value="https://00f2376ab228416e914217a8beb82511@10.40.40.47:801/72" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.6.1" />
    <trust level="Full" />
    <authentication mode="Forms">
      <forms ticketCompatibilityMode="Framework40" cookieless="UseCookies" name=".NAPFORMSAUTH" protection="All" loginUrl="~/User/Login" timeout="2880" defaultUrl="~/Sites/UserSites"></forms>
    </authentication>
    <sessionState mode="StateServer" cookieless="false" timeout="10" stateConnectionString="tcpip=10.40.40.127:42424"/>
    <machineKey validationKey="82DD5F7E8AEE17163191F82D6E74F88716B3A834BD6D1DC5F32CB2F613222E36144B019843C69D711C8EE551F341FDFD60B1AB77F943B02A00467A0D2D632EEB"
