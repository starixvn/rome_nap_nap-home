@model Fanex.NAP.Home.User.ViewModels.ChangePasswordViewModel
@{
    bool success = ViewBag.Success != null && ViewBag.Success;

    ViewBag.Title = ViewResources.Change_Password;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", id = "mainForm", @class = "form-horizontal col-sm-7 col-md-5 change-password form-custom" }))
{
    <div class="form-group summary">
        <div class="col-md-9 col-sm-9 col-xs-12 col-md-offset-3 col-sm-offset-3">
            @Html.ValidationSummary()
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-4 lbl-field">@Html.LabelFor(m => m.OldUserPwd)</div>
        <div class="col-xs-12 col-sm-7 col-md-8">
            @Html.PasswordFor(m => m.OldUserPwd, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-4 lbl-field">@Html.LabelFor(m => m.UserPwd)</div>
        <div class="col-xs-12 col-sm-7 col-md-8">
            @Html.PasswordFor(m => m.UserPwd, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-xs-12 col-sm-4 lbl-field">@Html.LabelFor(m => m.ConfirmUserPwd)</div>
        <div class="col-xs-12 col-sm-7 col-md-8">
            @Html.PasswordFor(m => m.ConfirmUserPwd, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-offset-4 col-xs-12 col-sm-7 col-md-8">
            <input type="submit" class="button-blue" value="@ViewResources.Save" />
            <input type="button" class="button-red" value="@ViewResources.Cancel" onclick="common.NavigateToRoot(''); return false;" />
        </div>
    </div>
}
@* To keep the behavior of the form and not change the code to much, we will pass the encrypted passwords
   to a hidden form and submit it instead of the original one *@
<form id="hiddenForm" method="post" novalidate="novalidate">
    <input type="hidden" id="token" name="token" value="@Model.Token" />
    <input type="hidden" id="oldPassword" name="OldUserPwd" value="@Model.OldUserPwd" />
    <input type="hidden" id="newPassword" name="UserPwd" value="@Model.UserPwd" />
    <input type="hidden" id="confirmPassword" name="ConfirmUserPwd" value="@Model.ConfirmUserPwd" />
</form>
@section Foot {
    @Scripts.Render("~/scripts/changePassword")
    @if (success)
    {
        <script type="text/javascript">
            $(function () {
                common.ShowInfoMessage('@ViewResources.Your_changes_were_saved!');
            });
        </script>
    }
}