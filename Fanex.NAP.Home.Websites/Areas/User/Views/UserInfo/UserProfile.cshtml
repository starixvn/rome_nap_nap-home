@using Fanex.NAP.Core.Criteria.User
@model UpdateCustCriteria
@{
    bool success = ViewBag.Success != null && ViewBag.Success;

    ViewBag.Title = ViewResources.User_Profile;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Headline {
    <section class="row">
        <span class="title">
            <span class="first">@HttpContext.Current.User.Identity.Name / </span>
            <span>@ViewResources.Profile</span>
        </span>
    </section>
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal col-md-5 col-sm-6 common-form" }))
{
    <div class="form-group summary">
        <div class="col-md-8 col-sm-8 col-xs-12 col-md-offset-3 col-sm-offset-3">
            @Html.ValidationSummary()
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-3 col-sm-3 col-xs-12 lbl-field">@Html.LabelFor(c => c.FirstName)</div>
        <div class="col-md-9 col-sm-9 col-xs-12">
            @Html.TextBoxFor(c => c.FirstName, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-3 col-sm-3 col-xs-12 lbl-field">@Html.LabelFor(c => c.LastName)</div>
        <div class="col-md-9 col-sm-9 col-xs-12">
            @Html.TextBoxFor(c => c.LastName, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-3 col-sm-3 col-xs-12 lbl-field">@Html.LabelFor(c => c.Email)</div>
        <div class="col-md-9 col-sm-9 col-xs-12">
            @Html.TextBoxFor(c => c.Email, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-offset-3 col-md-9 col-sm-9 col-xs-12">
            <input type="submit" value="@ViewResources.Save" />
            <button class="cancel-button" onclick="NAP.navigateToRoot('', 0); return false;">@ViewResources.Cancel</button>
        </div>
    </div>
    
    @Html.HiddenFor(m => m.GroupId)
}
@section Foot {
    @if (success)
    {
        <script type="text/javascript">
            $(function () {
                //NAP.headlineMsgBox.showInfo('@ViewResources.Your_changes_were_saved!', { closeBtn: false });
            });
        </script>
    }
}