@model Fanex.NAP.Home.User.ViewModels.ProfileViewModel
@{
    bool success = ViewBag.Success != null && ViewBag.Success;

    ViewBag.Title = ViewResources.User_Profile;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @role = "form", @class = "form-horizontal col-md-4 col-sm-7 form-custom user-profile" }))
{
    <div class="form-group summary">
        <div class="col-md-10 col-sm-10 col-xs-12 col-md-offset-2 col-sm-offset-2">
            @Html.ValidationSummary()
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-3 col-sm-3 col-xs-12 lbl-field">@Html.LabelFor(c => c.FirstName)</div>
        <div class="col-md-8 col-sm-8 col-xs-12">
            @Html.TextBoxFor(c => c.FirstName, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-3 col-sm-3 col-xs-12 lbl-field">@Html.LabelFor(c => c.LastName)</div>
        <div class="col-md-8 col-sm-8 col-xs-12">
            @Html.TextBoxFor(c => c.LastName, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-3 col-sm-3 col-xs-12 lbl-field">@Html.LabelFor(c => c.Email)</div>
        <div class="col-md-8 col-sm-8 col-xs-12">
            @Html.TextBoxFor(c => c.Email, new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-offset-3 col-md-8 col-sm-8 col-xs-12">
            <input type="submit" class="button-blue" value="@ViewResources.Save" />
            <input type="button" class="button-red" value="@ViewResources.Cancel" onclick="location.href='@Url.Content("~")'; return false;" />
        </div>
    </div>

    @Html.HiddenFor(m => m.GroupId)
}
@section Foot {
    @Scripts.Render("~/scripts/profile")
    @if (success)
    {
        <script type="text/javascript">
            $(function () {
                common.ShowInfoMessage('@ViewResources.Your_changes_were_saved!');
            });
        </script>
    }
}
