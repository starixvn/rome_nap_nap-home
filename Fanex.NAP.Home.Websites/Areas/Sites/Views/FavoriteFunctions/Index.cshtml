@using System.Text.RegularExpressions
@using Fanex.NAP.Home.Sites.ViewModels.FavoriteFunctions
@model PagerList<SiteItem>
@{
    ViewBag.Title = @ViewLang.FavoriteFunctions;
    Layout = "~/Areas/Sites/Views/Shared/_SitesLayout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/favoriteFunctions")
}
@if (Model != null && Model.Any())
{
    int counter = 0;

    <div class="col-sm-12 list-favorite">
        @foreach (SiteItem site in Model)
        {
            <div class="col-sm-4 site">
                <h4 class="title"><a href="@Url.Action("Forward", new { siteLink = site.SiteLink })" target="_blank">@site.SiteName</a></h4>
                <ul class="function-list list-unstyled">
                    @foreach (FavoriteFunctionItem favorite in site.FavoriteFunctions)
                    {
                        <li>
                            <a href="@Url.Action("Forward", new { siteLink = site.SiteLink, functionLink = favorite.Link })" target="_blank">
                                <span>@favorite.Path </span>
                            </a>
                            <span class="icon-favorite-medium" data-site-id="@site.SiteId" data-function-id="@favorite.FunctionId"></span>
                        </li>
                    }
                </ul>
            </div>

            counter++;

            if (counter % 3 == 0)
            {
                <div class="clearfix"></div>
            }
        }
        <div class="row paging fixed">
            @Html.Pager(Model, new PagerOptions()
       {
           PageIndexParameterName = "pageIndex",
           ShowFirstLast = true,
           ContainerTagName = "ul",
           CssClass = "link",
           NumericPagerItemWrapperFormatString = "<li><span class=\"link\">{0}</span></li>",
           CurrentPagerItemWrapperFormatString = "<li><span class=\"current\">{0}</span></li>",
           NavigationPagerItemWrapperFormatString = "<li><span class=\"btn-page\">{0}</span></li>",
           PrevPageText = "‹",
           NextPageText = "›",
           FirstPageText = "«",
           LastPageText = "»"
       }, new { @class = "list-unstyled" })
        </div>
    </div>
}
else
{
    <p>@ViewLang.ThereIsNoData</p>
}
@section Foot 
{
    @Scripts.Render("~/scripts/favoriteFunctions")
}