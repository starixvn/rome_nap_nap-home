@using System.Text.RegularExpressions
@using Fanex.NAP.Home.Sites.ViewModels.FavoriteFunctions
@model PagerList<SiteItem>
@{
    ViewBag.Title = @ViewLang.FavoriteFunctions;
    Layout = "~/Areas/Sites/Views/Shared/_SitesLayout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/favoriteFunctions")
}
@if (Model != null && Model.Any())
{
    int counter = 0;

    <div class="col-sm-12 list-favorite">
        @foreach (SiteItem site in Model)
        {
            if (counter == 0)
            {
                @Html.Raw("<div class=\"col-sm-4\">")
            }

            if ((counter != 0) && (counter > AppSettings.FavoriteLinesOfColumn))
            {
                @Html.Raw("</div><div class=\"col-sm-4\">")
                counter = 0;
            }

            counter += 2;

            <div class="row site">
                <h4 class="title">
                    <a href="#" data-strict-link="@string.Format("{{\"SiteId\": {0}, \"SiteLink\": \"{1}\"}}", site.SiteId, site.SiteLink)">@site.SiteName</a>
                </h4>
                <ul class="function-list list-unstyled">
                    @foreach (FavoriteFunctionItem favorite in site.FavoriteFunctions)
                    {
                        string linkParameters = string.Format(
                                                   "{{ \"SiteId\": {0}, \"SiteLink\": \"{1}\", \"FunctionId\": {2}, \"FunctionLink\": \"{3}\" }}",
                                                   site.SiteId,
                                                   site.SiteLink,
                                                   favorite.FunctionId,
                                                   favorite.Link);
                        counter++;

                        <li>
                            <a href="#" title="@favorite.Path" data-strict-link="@linkParameters">@favorite.Path.Truncate(40)</a>
                            <span class="icon-favorite-medium"
                                  title="@ViewLang.UnmarkingFavoriteInstruction"
                                  data-toggle="tooltip"
                                  data-placement="right"
                                  data-site-id="@site.SiteId"
                                  data-function-id="@favorite.FunctionId"></span>
                        </li>
                    }
                </ul>
            </div>
        }
        <div class="row paging fixed @(Model.HasPagers ? string.Empty : "hide")">
            @Html.Pager(Model, new PagerOptions()
            {
                PageIndexParameterName = "pageIndex",
                ShowFirstLast = true,
                ContainerTagName = "ul",
                CssClass = "link",
                NumericPagerItemWrapperFormatString = "<li><span class=\"link\">{0}</span></li>",
                CurrentPagerItemWrapperFormatString = "<li><span class=\"current\">{0}</span></li>",
                NavigationPagerItemWrapperFormatString = "<li><span class=\"btn-page\">{0}</span></li>",
                PrevPageText = "‹",
                NextPageText = "›",
                FirstPageText = "«",
                LastPageText = "»"
            }, new { @class = "list-unstyled" })
        </div>
    </div>
}
else
{
    <p>@ViewLang.ThereIsNoData</p>
}
@section Foot 
{
    @Scripts.Render("~/scripts/favoriteFunctions")
}