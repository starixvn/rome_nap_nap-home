@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="row title-bar">
    <span class="title">@ViewLang.Products</span>
    <div class="search-bar pull-right">
        <input type="text" class="search" placeholder="@ViewLang.SearchPlaceholder" />
        <button type="button" class="button-green custom-height">@ViewLang.Search</button>
    </div>
    <span class="icon-arrow-down"></span>
</div>
@RenderBody()