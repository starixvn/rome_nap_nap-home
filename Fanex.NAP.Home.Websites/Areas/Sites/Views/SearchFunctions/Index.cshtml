@using System.Text.RegularExpressions
@using Fanex.NAP.Home.Sites.ViewModels.SearchFunctions
@model PagerList<SearchedFunctionItem>
@{
    string searchedFunctionName = (string)ViewBag.SearchedFunctionName;
    ViewBag.Title = @ViewLang.SearchResults;
    Layout = "~/Areas/Sites/Views/Shared/_SitesLayout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/searchFunctions")
}
@if (Model != null && Model.Any())
{
    <div class="col-sm-12 result">
        <div class="row search-total">
            <div class="col-sm-12 total">
                @Html.Raw(string.Format(ViewLang.SearchResult, "<span class=\"number\">" + Model.TotalItemCount + "</span>"))
            </div>
        </div>
        <div class="row search-result">
            @foreach (SearchedFunctionItem function in Model)
            {
                string linkParameters = string.Format(
                                                   "{{ \"SiteId\": {0}, \"SiteLink\": \"{1}\", \"FunctionId\": {2}, \"FunctionLink\": \"{3}\" }}",
                                                   function.SiteId,
                                                   function.SiteLink.Trim(),
                                                   function.FunctionId,
                                                   function.Link.Trim());
                <div class="col-sm-12 col-md-6 search-item">
                    <h4>
                        @HighlightWordsInLink(searchedFunctionName, function.FunctionName, linkParameters)
                        <span class="icon-star @(@function.IsFavorite ? "icon-favorite-medium" : "icon-noneFavorite-medium")"
                              title="@(function.IsFavorite ? ViewLang.UnmarkingFavoriteInstruction : ViewLang.MarkingFavoriteInstruction)"
                              data-site-id="@function.SiteId"
                              data-function-id="@function.FunctionId"
                              data-toggle="tooltip"
                              data-placement="right"></span>
                    </h4>
                    <div class="desc-item clearfix">
                        <span class="pull-left">@ViewLang.Path: </span>
                        <a href="javascript:void(0);" title="@function.Path" data-strict-link="@linkParameters">
                            <span class="site-name">@function.SiteName</span>
                            <span> » @function.Path.Truncate(65 - function.SiteName.Length - 3)</span>
                        </a>
                    </div>
                </div>
            }
        </div>
        <div class="row paging fixed @(Model.HasPagers ? string.Empty : "hide")">
            @Html.Pager(Model, new PagerOptions()
            {
                PageIndexParameterName = "pageIndex",
                ShowFirstLast = true,
                ContainerTagName = "ul",
                CssClass = "link",
                NumericPagerItemWrapperFormatString = "<li><span class=\"link\">{0}</span></li>",
                CurrentPagerItemWrapperFormatString = "<li><span class=\"current\">{0}</span></li>",
                NavigationPagerItemWrapperFormatString = "<li><span class=\"btn-page\">{0}</span></li>",
                PrevPageText = "‹",
                NextPageText = "›",
                FirstPageText = "«",
                LastPageText = "»"
            }, new { @class = "list-unstyled" })
        </div>
    </div>
}
else
{
    <p>@ViewLang.ThereIsNoData</p>
}
@section Foot 
{
    @Scripts.Render("~/scripts/searchFunctions")
}
@helper HighlightWordsInLink(string keyword, string text, string linkParameters)
{
    var formatter = new Regex(keyword, RegexOptions.IgnoreCase);
    string result = formatter.Replace(text, delegate(Match match)
    {
        return string.Format("<b>{0}</b>", match.Value);
    });

    <a href="javascript:void(0);" data-strict-link="@linkParameters">@Html.Raw(result)</a>
}