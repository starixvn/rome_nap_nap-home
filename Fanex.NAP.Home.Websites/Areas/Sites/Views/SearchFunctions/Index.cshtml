@using System.Text.RegularExpressions
@using Fanex.NAP.Home.Sites.ViewModels.SearchFunctions
@model PagerList<SearchedFunctionItem>
@{
    string searchedFunctionName = (string)ViewBag.SearchedFunctionName;
    ViewBag.Title = @ViewLang.SearchResults;
    Layout = "~/Areas/Sites/Views/Shared/_SitesLayout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/searchFunctions")
}
@if (Model != null && Model.Any())
{
    <div class="col-sm-12 search-total">@Html.Raw(string.Format(ViewLang.SearchResult, "<span class=\"number\">" + Model.TotalItemCount + "</span>"))</div>
    <div class="col-sm-12 search-result">
        @foreach (SearchedFunctionItem function in Model)
        {
            <div class="col-sm-12 col-md-6 search-item">
                <h4>
                    @HighlightWordsInLink(searchedFunctionName, function.FunctionName, function.Link)
                    <span class="icon-star @(@function.IsFavorite ? "icon-favorite-medium" : "icon-noneFavorite-medium")"
                          title="@ViewLang.MarkingFavoriteInstruction"
                          data-site-id="@function.SiteId"
                          data-function-id="@function.FunctionId"
                          data-toggle="tooltip"
                          data-placement="right">
                    </span>
                </h4>
                <div class="desc-item clearfix"><span class="pull-left">@ViewLang.Path:</span> <a href="@function.Link">@function.Path</a></div>
            </div>
        }
    </div>
    <div class="col-sm-12 paging">
        @Html.Pager(Model, new PagerOptions()
        {
            PageIndexParameterName = "pageIndex",
            ShowFirstLast = true,
            ContainerTagName ="ul",
            CssClass = "link",
            PageNumberFormatString = "<a class=\"link\" href=\"#\">{0}</a>",
            NumericPagerItemWrapperFormatString = "<li>{0}</li>",
            CurrentPagerItemWrapperFormatString = "<li><span class=\"current\">{0}</span></li>",
            CurrentPageNumberFormatString = "{0}",
            NavigationPagerItemWrapperFormatString = "<li><span class=\"btn-page\">{0}</li>",
            PrevPageText = "‹",
            NextPageText =  "›",
            FirstPageText = "«",
            LastPageText = "»"
        }, new { @class = "list-unstyled" })
    </div>
}
else
{
    <p>@ViewLang.ThereIsNoData</p>
}
@section Foot 
{
    @Scripts.Render("~/scripts/searchFunctions")
}
@helper HighlightWordsInLink(string keyword, string text, string link)
    {
    var formatter = new Regex(keyword, RegexOptions.IgnoreCase);
    string result = formatter.Replace(text, delegate(Match match)
    {
        return string.Format("<b>{0}</b>", match.Value);
    });

    <a href="@link">@Html.Raw(result)</a>
}