@using Fanex.NAP.Home.Sites.ViewModels.UserSites
@model IEnumerable<UserSiteFunctionItem>
@if (Model != null && Model.Any())
{
    Dictionary<int, string> defaulLinks = null;
    string siteLink = string.Empty;

    if (ViewBag.DefaultLinks != null)
    {
        defaulLinks = ViewBag.DefaultLinks as Dictionary<int, string>;
        siteLink = defaulLinks[Model.ElementAt(0).SiteId];
    }

    <ul class="list-unstyled link">
        @foreach (var favorite in Model)
        {
            string link = Url.Action("Forward", new { siteLink = siteLink, functionLink = favorite.Link });
            <li><a href="@link" target="_blank" title="@favorite.FunctionName"><span class="icon-favourite"></span>@favorite.FunctionName.Truncate(53)</a></li>
        }
    </ul>
}