@using Fanex.NAP.Home.Sites.ViewModels.UserSites
@model List<SiteItem>
@{
    var hiddenMenuSites = new List<string> { };
    ViewBag.Title = @ViewLang.Sites;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (Model != null && Model.Any())
{
    string thumbnailLink = "~/Areas/Sites/Resources/UserSites/Thumbnails/{0}";
    string functionGroupFormat = "--- {0} ---";
    int totalFunctionCount = string.IsNullOrEmpty(ViewBag.SearchedFunctionName) ? 0 : Model.Sum(site => site.FunctionGroupList.Count);
    int numberOfSites = Model.Count();
    int siteCounter = 0;

    if (totalFunctionCount > 0)
    {
        <p class="result">@string.Format(ViewLang.SearchResult, totalFunctionCount) <a href="@Url.Content("~/")">@ViewLang.BackToHome</a></p>
    }

    foreach (SiteItem site in Model)
    {
        string defaultLinkParameters = string.Format("{{ \"SiteId\": {0}, \"SiteLink\": \"{1}\" }}", site.SiteId, site.DefaultLink);
        string thumbnailClass = numberOfSites <= AppSettings.NumberOfSitesPerRow ? "one-row-thumbnail" : string.Empty;
        string thumbnailContentClass = string.Empty;
        bool hasDomains = site.OtherLinkList != null && site.OtherLinkList.Count > 0;


        siteCounter++;

        if (siteCounter % AppSettings.NumberOfSitesPerRow == 1)
        {
            thumbnailContentClass += "firstchild-of-row";
        }

        var partialViewData = new ViewDataDictionary {
            { "thumbnailContentClass", thumbnailContentClass } ,
            { "numberOfSites", numberOfSites },
            { "numberOfSitesPerRow", AppSettings.NumberOfSitesPerRow }
        };

        var isHiddenMenuSite = hiddenMenuSites.Any(s => site.SiteName.Contains(s));
        if (isHiddenMenuSite)
        {
            <div>
                @Html.Partial("_HiddenMenuSite", site, partialViewData)
            </div>
        }
        else
        {
            <div>
                @Html.Partial("_NormalSite", site, partialViewData)
            </div>
        }

    }
}
else
{
    <p class="result">@ViewLang.ThereIsNoData <a href="@Url.Content("~/")">@ViewLang.BackToHome</a></p>
}