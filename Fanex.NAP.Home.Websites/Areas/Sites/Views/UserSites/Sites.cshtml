@using Fanex.NAP.Home.Sites.ViewModels.UserSites
@model IEnumerable<UserSiteItem>
@{
    ViewBag.Title = @ViewLang.Sites;
    Layout = "~/Areas/Sites/Views/Shared/_SitesLayout.cshtml";
}
@section Head
{
    @Styles.Render("~/styles/userSites")
}
@{
    string thumnailUrlTemplate = "~/Areas/Sites/Resources/UserSites/Images/{0}/{1}";

    if (Model != null && Model.Any())
    {
        foreach (var site in Model)
        {
            string thumnailUrl = string.Format(thumnailUrlTemplate, site.Favorites.Count > 0 ? "Favorite" : "NonFavorite", site.Thumbnail);
            string defaultLinkParameters = string.Format("{{ \"SiteId\": {0}, \"SiteLink\": \"{1}\" }}", site.SiteId, site.DefaultLink);
            
            <div class="col-xs-12 col-sm-6 col-md-4">
                <div class="description" data-site-id="@site.SiteId" data-link-tile="@defaultLinkParameters">
                    <img src="@Url.Content(thumnailUrl)" class="bg-img img-responsive" title="@site.SiteName" alt="@site.SiteName" />
                    @Html.Partial("TopFavoriteFunctions", site.Favorites)
                    <div class="text-title">
                        <a href="#" title="@site.SiteName" data-strict-link="@defaultLinkParameters">@site.SiteName.Truncate(30)</a>
                        <div class="menu-button function-button">
                            <span class="icon-function" title="@ViewLang.FunctionList"></span>
                        </div>
                        <div class="menu-wrapper function-menu-wrapper"></div>
                        <div class="menu-button domain-button">
                            <span class="icon-arrow-site @(site.Domains.Count == 0 ? "disabled" : string.Empty)" title="@ViewLang.Domains"></span>
                        </div>
                        @if (site.Domains.Count > 0)
                        {
                            <div class="menu-wrapper domain-menu-wrapper">
                                <ul class="menu-content list-unstyled">
                                    @foreach (var domain in site.Domains)
                                    {
                                        <li>
                                            <a href="#" data-strict-link="@string.Format("{{ \"SiteId\": {0}, \"SiteLink\": \"{1}\" }}", site.SiteId, domain)">@domain</a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                    <div class="shadow">
                        <img src="~/Content/Theme/Images/shadow.png" title="shadow" alt="shadow" class="img-responsive margin-auto" />
                    </div>
                </div>
            </div>
        }
    }
}
@section Foot 
{
    @Scripts.Render("~/scripts/userSites")
}