@using Fanex.NAP.Home.Sites.ViewModels.UserSites
@model IEnumerable<UserSiteFunctionItem>
@if (Model != null && Model.Any())
{
    <ul class="list-unstyled menu-content">
        @FunctionTree(Model)
    </ul>
}

@helper FunctionTree (IEnumerable<UserSiteFunctionItem> functions)
{
    if (functions != null && functions.Any())
    {
        foreach (UserSiteFunctionItem function in functions)
        {
            if (function.Children.Any())
            {
                <li class="function-group">
                    <span class="group-node expand-node" title="@function.FunctionName"><span class="icon-expand"></span>@function.FunctionName.Truncate(35)</span>
                    <ul class="list-unstyled sub-function">
                        @FunctionTree(function.Children)
                    </ul>
                </li>
            }
            else
            {
                <li>
                    <span class="icon-star @(function.IsFavorite ? "icon-favourite" : "icon-noneFavourite")"
                          title="@ViewLang.MarkingFavoriteInstruction"
                          data-function-id="@function.FunctionId">
                    </span>
                    <a href="@function.Link" title="@function.FunctionName">@function.FunctionName.Truncate(35)</a>
                </li>
            }
        }
    }
}