@using Fanex.NAP.Home.Sites.ViewModels.UserSites
@model IEnumerable<UserSiteFunctionItem>
@if (Model != null && Model.Any())
{
    Dictionary<int, string> defaulLinks = null;
    string siteLink = string.Empty;

    if (ViewBag.DefaultLinks != null)
    {
        defaulLinks = ViewBag.DefaultLinks as Dictionary<int, string>;
        siteLink = defaulLinks[Model.ElementAt(0).SiteId];
    }

    <ul class="list-unstyled menu-content">
        @FunctionTree(Model, siteLink)
    </ul>
}
else
{
    <p class="no-function">@ViewLang.ThereIsNoData</p>
}

@helper FunctionTree (IEnumerable<UserSiteFunctionItem> functions, string siteLink)
{
    if (functions != null && functions.Any())
    {
        foreach (UserSiteFunctionItem function in functions)
        {
            if (function.Children.Any())
            {
                <li class="function-group">
                    <span class="group-node expand-node" title="@function.FunctionName"><span class="icon-expand"></span>@function.FunctionName.Truncate(35)</span>
                    <ul class="list-unstyled sub-function">
                        @FunctionTree(function.Children, siteLink)
                    </ul>
                </li>
            }
            else
            {
                string linkParameters = string.Format(
                                                   "{{ \"SiteId\": {0}, \"SiteLink\": \"{1}\", \"FunctionId\": {2}, \"FunctionLink\": \"{3}\" }}",
                                                   function.SiteId,
                                                   siteLink,
                                                   function.FunctionId,
                                                   function.Link);
                <li>
                    <span class="icon-star @(function.IsFavorite ? "icon-favourite" : "icon-noneFavourite")"
                          title="@(function.IsFavorite ? ViewLang.UnmarkingFavoriteInstruction : ViewLang.MarkingFavoriteInstruction)"
                          data-placement="top"
                          data-container="body"
                          data-function-id="@function.FunctionId">
                    </span>
                    <a href="#" title="@function.FunctionName" data-strict-link="@linkParameters">@function.FunctionName.Truncate(30)</a>
                </li>
            }
        }
    }
}