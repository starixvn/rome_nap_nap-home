<head>
    <meta charset="utf-8" />
    <title>@ViewResources.Log_In</title>
    <meta name="viewport" content="width=device-width" />
    @Styles.Render("~/styles/login")
</head>
<body>
    <div id='divWarningPanel' class="not-supported-browser-panel">
        Your browser is no longer supported. Some parts will not work and you may experience
        problems.<br />
        If you are having problems, try <a href='http://browsehappy.com/'>this</a> for full
        browsing experience. Thank you!
    </div>
    @using (Html.BeginForm())
    {
        <div class="login-box">
            <div id="divMessage" class="msg">
                <span id="divInnerMsg">@ViewBag.Message</span>
            </div>
            <div class="header">
                <div class="welcome">
                </div>
                <div class="secure">
                </div>
            </div>
            <div class="auth">
                <input type="text" id="txtUsername" name="username" class="username" autocomplete="off" />
                <input type="password" id="txtPassword" class="password" />
                <input type ="hidden" id="hdnPassword" name="password" />
                <input type ="hidden" id="hdnLoginToken" name="loginToken" value="@ViewBag.LoginToken" />
                <input type="submit" id="btnSubmit" value="@ViewResources.Log_In" class="submit" />
            </div>
        </div>
    }
    @Scripts.Render("~/scripts/login")
