@model IEnumerable<SiteUrl>
@{
    ViewBag.Title = ViewResources.Sites;
    Layout = null;

    var SiteUrlList = Model.Select(x => x.Site.Name).Distinct()
        .Select(x => Model.Where(su => su.Site.Name == x).ToList())
        .ToDictionary(x => x.First().Site.Name);
}
<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en">
<!--<![endif]-->
<head>
    <meta http-equiv="content-type" content="text/html; charset=UTF-8" />
    <title>@ViewBag.Title</title>
    <link href="~/areas/userlogin/themes/select-site.less" rel="stylesheet" type="text/css" />
    <script src="~/areas/userlogin/scripts/lib/jquery-1.8.0.min.js" type="text/javascript"></script>
    <link href="~/Areas/UserLogin/scripts/lib/msgbox/msgbox-0.0.1.css" rel="stylesheet"
        type="text/css" />
    <script src="~/Areas/UserLogin/scripts/lib/msgbox/msgbox-0.0.1.js" type="text/javascript"></script>
    @if (ViewBag.ViewFlags != null && ViewBag.ViewFlags.IsReCheckin)
    { 
        <script src="~/Areas/UserLogin/scripts/ReCheckIn.js" type="text/javascript"></script>
    }
</head>
<body>
    <div id="header">
        <div class="logo">
            @ViewResources.NAP_Hub</div>
        <div class="auth">
            @ViewResources.Howdy, @HttpContext.Current.User.Identity.Name
            <span class="sep">|</span>
            @Html.ActionLink(ViewResources.Log_Out, "LogOut", "Login", new { Area = "UserLogin" }, new { })
        </div>
    </div>
    <div class="sites">
        @foreach (var item in SiteUrlList)
        {
            var defaultUrl = item.Value.Where(x => x.IsDefault).FirstOrDefault() ?? item.Value.FirstOrDefault();

            if (defaultUrl != null)
            {
            <div class="site">
                @Html.ActionLink(defaultUrl.Site.Name, "Forward",
                    new { id = defaultUrl.SiteUrlId },
                    new { target = "_blank", @class = "name" })
                @if (item.Value.Count > 1)
                {
                    <a href="javascript:;" class="url-toggle">
                        <ul class="urls">
                            @foreach (var siteUrl in item.Value)
                            {
                                string url = Url.Action("Forward", new { id = siteUrl.SiteUrlId });
                            
                                <li onclick="window.open('@url', '_blank')">@siteUrl.Url</li>
                            }
                        </ul>
                    </a>
                }
            </div>
            }
        }
    </div>
    <input type="hidden" id="hdfOnUserId" value="@ViewBag.OnUserId" />
    @Html.Hidden("NapHubRoot", Url.Content("~/"))
    @*<script src="~/areas/userlogin/script/recheckin.js" type="text/javascript"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            var idx = 1;
            $('.site').each(function () {
                $(this).delay(idx * 60).fadeIn(function () {
                    $(this).children('a.name').css({ 'padding-left': '60px', 'padding-right': '60px' });
                });

                idx++;
            });
        });

    </script>*@
</body>
</html>
