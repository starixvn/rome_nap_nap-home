<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=152368
  -->
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />
    <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
  </configSections>
  <NapSettings UMAddress="tcp://10.40.40.200:8989/LoadBalancerInterface" Environment="UAT" EnableDirectLogin="0" SiteId="0" EnableCheckUM="false" EnableReCheckin="false" HubUrl="http://localhost:54332/NAPHub">
    <Domain>
      <add Name="localhost:54332" Path="/NAPHub1"></add>
      <add Name="localhost:54332" Path="/NAPHub"></add>
      <add Name="10.18.200.201:8009" Path="/NAPHub1"></add>
    </Domain>
  </NapSettings>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="~/App_Data/" enableWatching="1" ignoreExceptionIsNotParameters="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.18.200.209\private$\entlib" defaultCategory="NAP-Admin-Local" />
  <appSettings>
    <add key="webpages:Version" value="2.0.0.0" />
    <add key="webpages:Enabled" value="true" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="Environment" value="LIVE" />
    <add key="IsSiteLogin" value="0" />
    <add key="SiteId" value="0" />
    <add key="app_mail_address" value="$app_mail_address_value" />
    <add key="app_mail_id" value="$app_mail_id_value" />
  </appSettings>
  <connectionStrings configSource="WebConnectionString.config" />
  <system.web>
    <compilation debug="true" targetFramework="4.0" />
    <trust level="Full" />
    <authentication mode="Forms">
      <forms ticketCompatibilityMode="Framework40" cookieless="UseCookies" loginUrl="~/UserLogin/Login" timeout="2880" defaultUrl="~/UserLogin/UserSite/Site"></forms>
    </authentication>
    <sessionState mode="StateServer" cookieless="false" timeout="20000" />
    <!--<authorization>
            <deny users="?" />
        </authorization>-->
    <customErrors mode="Off" defaultRedirect="~/Common/Error/">
      <!--      <error statusCode="403" redirect="~/User/Unauthorize/"/>
      <error statusCode="404" redirect="~/Common/NotFound/"/> -->
    </customErrors>
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>
    <httpHandlers>
      <add path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler, dotless.Core" />
    </httpHandlers>
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <handlers>
      <add name="dotless" path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler,dotless.Core" resourceType="File" preCondition="" />
    </handlers>
    <staticContent>
      <remove fileExtension=".less" />
    </staticContent>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="NPOI" publicKeyToken="0df73ec7942b34e1" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.2.5.0" newVersion="1.2.5.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <location path="Areas/UserLogin/Themes">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <dotless minifyCss="false" cache="true" web="false" />
</configuration>